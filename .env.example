# Copy this file to `.env` (kotlin/.env) and adjust for your machine.
# `.env` is gitignored — each dev keeps their own local backend URL here.

# 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
# If you're on a physical device on the same network as the backend, use
# your machine's LAN IP instead (e.g. http://10.10.14.57:8080/).
BASE_URL=http://10.10.14.57:8080/

# HMAC signing (X-Timestamp/X-Signature/X-Client-Type, see HmacInterceptor).
# secretKey is the single global HMAC key shared by every client (matches
# application.security.jwt.secret-key on the backend) - apiKey is per-client-type,
# looked up server-side from dbo.dbh_api_param by X-Client-Type.
API_KEY=5338096e064795e6a11ae3758a6ed2786b613a5d
SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CLIENT_TYPE=ANDROID

# Release signing - only needed to produce a signed AAB/APK. NOT read from this .env file -
# signingValue() in build.gradle.kts only reads REAL OS env vars or kotlin/keystore.properties
# (gitignored), never this file. Leave unset locally; release builds just stay unsigned for
# testing. To sign locally, create kotlin/keystore.properties with:
#   storeFile=/path/to/release.jks
#   storePassword=...
#   keyAlias=...
#   keyPassword=...
# For CI, see .github/workflows/kotlin.yml (RELEASE_KEYSTORE_BASE64 + related secrets).
